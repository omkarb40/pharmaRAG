# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Environments ----
.venv/
venv/
.env
*.env
!.env.example

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Vector stores & built indexes (rebuild with scripts/build_index.py) ----
chroma_db/
data/index/
data/processed/chunk_embeddings.npy
*.sqlite3

# ---- Raw source documents (re-fetch with scripts/ingest_dailymed.py) ----
data/raw/

# ---- Backups & stale artefacts ----
*_backup_*/
*backup*/
demos/data/

# ---- Vendored third-party repos (not used; see Limitations in README) ----
external/

# ---- Large annotation working files ----
annotation_worksheet.txt
worksheet_*.txt

# ---- Source documents kept out of the code repo ----
*.docx

# ---- Archived evaluation runs (canonical results are tracked) ----
evaluation/results/_archive/

# ---- TRACKED ON PURPOSE (do not ignore) ----
# data/processed/chunks.jsonl     <- the 723-chunk corpus
# evaluation/test_queries_v2.json <- the 85-query benchmark
# evaluation/iaa/                 <- inter-annotator agreement packet
# evaluation/results/*.json       <- canonical run outputs
# logs/*.jsonl                    <- audit log samples
# figures/*.png                   <- report figures
data/index_pre_corpusfix_*/
evaluation/heldout/raw/*.txt
evaluation/heldout/heldout_pairs.csv
evaluation/heldout/heldout_v1.json
